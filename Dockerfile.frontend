# FirstMilestone Angular image
FROM node:22-alpine AS build
WORKDIR /app
COPY src/frontend/first-milestone/package*.json ./
RUN npm install --no-audit --no-fund
COPY src/frontend/first-milestone/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY src/frontend/first-milestone/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/first-milestone/browser /usr/share/nginx/html
EXPOSE 80
